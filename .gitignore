# Build artifacts: single entry build/<target-triple>/<profile> (ADR-0008)
build/
.worktrees/
*.o
*.out

# Python
__pycache__/
.venv/
*.pyc

# Data layers: private/restricted never enter git history (ADR-0003)
data/private/
data/restricted/

# Run raw samples: regenerable intermediates, kept local only (ADR-0008
# 数据策略：git 只收 records/manifests，raw/ 由 SHA256 manifest 锚定完整性)
data/public/runs/*/raw/

# Personal reference materials live OUTSIDE the repo tree (see
# docs/reference-materials.md): ../cpu-uarch-ref/ — nothing to ignore here.

# OS noise
.DS_Store

# 个人笔记工具配置（Obsidian 工作区设置，与项目内容无关）
.obsidian/

# gem5 in-tree build outputs (submodule's own .gitignore also covers build/)
third_party/gem5/build/
