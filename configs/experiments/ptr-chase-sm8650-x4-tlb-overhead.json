{
  "schema_version": "1.0",
  "id": "ptr-chase-sm8650-x4-tlb-overhead",
  "title": "SM8650 X4 TLB §5.3 固定开销扫描（两点 × 三长度 × 4 order_seed）",
  "protocol_version": "1.2",
  "harness": "portable",
  "parameters": [
    { "name": "buffer", "type": "size", "range": "512KiB..16MiB，floor 区与 walk-active 区两点" },
    { "name": "stride", "type": "size", "default": "64B" },
    { "name": "warmup_passes", "type": "int", "default": 2 },
    { "name": "loads_per_slot", "type": "int", "default": 8, "range": "8/64/256 ring passes 三档测量长度（sweep）" },
    { "name": "min_loads", "type": "int", "default": 4096 },
    { "name": "repetitions", "type": "int", "default": 10 },
    { "name": "base_pages", "type": "int", "default": 1 },
    { "name": "seed", "type": "int", "default": 42 },
    {
      "name": "pmu_events",
      "type": "pmu-event-list",
      "default": [
        { "name": "cycles", "type": 8, "config": "0x11" },
        { "name": "mem_access_rd", "type": 8, "config": "0x66" },
        { "name": "l1d_tlb_refill", "type": 8, "config": "0x05" },
        { "name": "dtlb_walk", "type": 8, "config": "0x34" }
      ]
    }
  ],
  "preconditions": [
    "redmi-k70pro-01 controlled-baseline profile 前后门禁通过",
    "CPU7 Cortex-X4；四个 core PMU event 同窗且 time_running == time_enabled（拒绝复用）",
    "每个 repetition 为新进程/新匿名映射；actual backing 必须为 base；逐样本 seed 入档"
  ],
  "metrics": [
    { "name": "latency_ns", "unit": "ns", "statistic": "median" },
    { "name": "pmu.cycles.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.mem_access_rd.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.l1d_tlb_refill.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.dtlb_walk.count", "unit": "events", "statistic": "median" }
  ],
  "execution": {
    "probe": "ptr_chase",
    "controls": ["x4-prime"],
    "params": { "repetitions": 10 },
    "sweep": {
      "buffer": ["512KiB", "16MiB"],
      "loads_per_slot": [8, 64, 256],
      "seed": [42, 7, 1337, 20260928]
    },
    "fixed_params": [
      "stride", "warmup_passes", "min_loads", "base_pages", "pmu_events"
    ]
  },
  "notes": "§5.3 PMU 窗与墙钟窗固定开销扫描（M2；计划 docs/superpowers/plans/2026-09-28-sm8650-tlb-hierarchy.md）：512KiB（floor 区）与 16MiB（walk-active 区）两点 × loads_per_slot 8/64/256 三档测量长度（每长度 ≥1 完整环）× 4 order_seed（同步检验斜率稳定性）= 24 case，G0 事件组、base 映射、warmup 恒 2 环。用途：逐事件拟合 C_e(N)=a_e+b_e·N（N=timed loads）；正式窗口长度下 |a_e|/C_e(N) ≤5% 判定该事件边界开销可忽略并标注，超阈值事件绝对密度只报\"含固定开销\"、转折判定改用跨长度一致斜率 b_e。loads_per_slot 移入 sweep（min_loads 保持 fixed 不生效）。"
}
