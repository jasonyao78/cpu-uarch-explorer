{
  "schema_version": "1.0",
  "id": "ptr-chase-sm8650-x4-tlb-assoc-g2",
  "title": "SM8650 X4 TLB Phase C 关联曲线 G2 组（walk 活动事件）",
  "protocol_version": "1.2",
  "harness": "portable",
  "parameters": [
    { "name": "buffer", "type": "size", "range": "walk-floor 1024 页 / onset-edge 2560 页 / active-plateau 3584 页（§7 Phase C，由 Phase B 数据按 §6.2.3 确定）" },
    { "name": "stride", "type": "size", "default": "64B" },
    { "name": "warmup_passes", "type": "int", "default": 2 },
    { "name": "loads_per_slot", "type": "int", "default": 8 },
    { "name": "min_loads", "type": "int", "default": 4096 },
    { "name": "repetitions", "type": "int", "default": 10 },
    { "name": "base_pages", "type": "int", "default": 1 },
    { "name": "seed", "type": "int", "default": 42 },
    {
      "name": "pmu_events",
      "type": "pmu-event-list",
      "default": [
        { "name": "cycles", "type": 8, "config": "0x11" },
        { "name": "l1d_tlb_refill", "type": 8, "config": "0x05" },
        { "name": "dtlb_walk", "type": 8, "config": "0x34" },
        { "name": "dtlb_step", "type": 8, "config": "0x8136" },
        { "name": "dtlb_walk_percyc", "type": 8, "config": "0x8128" }
      ]
    }
  ],
  "preconditions": [
    "redmi-k70pro-01 controlled-baseline profile 前后门禁通过",
    "CPU7 Cortex-X4；五个 core PMU event 同窗且 time_running == time_enabled（拒绝复用）",
    "每个 repetition 为新进程/新匿名映射；actual backing 必须为 base；逐样本 seed 入档"
  ],
  "metrics": [
    { "name": "latency_ns", "unit": "ns", "statistic": "median" },
    { "name": "pmu.cycles.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.l1d_tlb_refill.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.dtlb_walk.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.dtlb_step.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.dtlb_walk_percyc.count", "unit": "events", "statistic": "median" }
  ],
  "execution": {
    "probe": "ptr_chase",
    "controls": ["x4-prime"],
    "params": { "repetitions": 10 },
    "sweep": {
      "buffer": ["4096KiB", "10240KiB", "14336KiB"],
      "seed": [42, 7]
    },
    "fixed_params": [
      "stride", "warmup_passes", "loads_per_slot", "min_loads",
      "base_pages", "pmu_events"
    ]
  },
  "notes": "§7 Phase C Q3 关联曲线 G2 组（§5.2：cycles, 0x05, 0x34 + 注册后的 0x8136/0x8128，合计 5——按 §5.2 G2 行原文不含 mem_access_rd）。选点 = walk-floor(1024)/onset-edge(2560)/active-plateau(3584)，由 Phase B onset 终态 [2560,3072] 确定。默认终态 MODEL_UNIDENTIFIABLE：G2 提供 translation activity 与 walker 指标关联，不做成本型估计（§7 Phase C，本计划不含冻结模型规格）。"
}
