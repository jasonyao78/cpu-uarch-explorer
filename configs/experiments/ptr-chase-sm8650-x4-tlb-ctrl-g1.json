{
  "schema_version": "1.0",
  "id": "ptr-chase-sm8650-x4-tlb-ctrl-g1",
  "title": "SM8650 X4 TLB Gate 1 正控① L2 TLB 事件（0x2d/0x2f，128 vs 4096 页）",
  "protocol_version": "1.2",
  "harness": "portable",
  "parameters": [
    { "name": "buffer", "type": "size", "range": "512KiB..16MiB，128 vs 4096 随机 4KiB 页的 floor/scale 锚点" },
    { "name": "stride", "type": "size", "default": "64B" },
    { "name": "warmup_passes", "type": "int", "default": 2 },
    { "name": "loads_per_slot", "type": "int", "default": 8 },
    { "name": "min_loads", "type": "int", "default": 4096 },
    { "name": "repetitions", "type": "int", "default": 10 },
    { "name": "base_pages", "type": "int", "default": 1 },
    { "name": "seed", "type": "int", "default": 42 },
    {
      "name": "pmu_events",
      "type": "pmu-event-list",
      "default": [
        { "name": "cycles", "type": 8, "config": "0x11" },
        { "name": "mem_access_rd", "type": 8, "config": "0x66" },
        { "name": "l1d_tlb_refill", "type": 8, "config": "0x05" },
        { "name": "dtlb_walk", "type": 8, "config": "0x34" },
        { "name": "l2d_tlb_refill", "type": 8, "config": "0x2d" },
        { "name": "l2d_tlb", "type": 8, "config": "0x2f" }
      ]
    }
  ],
  "preconditions": [
    "redmi-k70pro-01 controlled-baseline profile 前后门禁通过",
    "CPU7 Cortex-X4；六个 core PMU event 同窗且 time_running == time_enabled（拒绝复用）",
    "每个 repetition 为新进程/新匿名映射；actual backing 必须为 base；逐样本 seed 入档"
  ],
  "metrics": [
    { "name": "latency_ns", "unit": "ns", "statistic": "median" },
    { "name": "pmu.cycles.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.mem_access_rd.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.l1d_tlb_refill.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.dtlb_walk.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.l2d_tlb_refill.count", "unit": "events", "statistic": "median" },
    { "name": "pmu.l2d_tlb.count", "unit": "events", "statistic": "median" }
  ],
  "execution": {
    "probe": "ptr_chase",
    "controls": ["x4-prime"],
    "params": { "repetitions": 10 },
    "sweep": {
      "buffer": ["512KiB", "16MiB"]
    },
    "fixed_params": [
      "stride", "warmup_passes", "loads_per_slot", "min_loads",
      "base_pages", "seed", "pmu_events"
    ]
  },
  "notes": "Gate 1 步骤①：0x2d/0x2f 方向性正控（计划 docs/superpowers/plans/2026-09-28-sm8650-tlb-hierarchy.md，任务书 §5.1/§5.2 G1 组）：G0 四事件 + CANDIDATE 事件 l2d_tlb_refill(0x2d)/l2d_tlb(0x2f)（name 按 §3.1 表 TRM 名小写落仓内惯例）；512KiB=128 页 floor 应近零、16MiB=4096 页 scale 应产生规模计数，方向与预期一致、跨进程稳定、无恒零才升 QUALIFIED（写 configs/pmu-event-registry.json）。seed 固定 42 不 sweep。"
}
